# Copier vers .env.local puis adapter.

# Active le mode démonstration : bandeau « données simulées » + connexion rapide
# aux comptes de démonstration (client, agent, administrateur) sans mot de passe.
# À désactiver (false) pour toute exposition hors démonstration.
FLAMOB_DEMO_MODE=true

# Mot de passe optionnel des comptes de démonstration (connexion classique).
# Laisser vide : les comptes de démo ne sont accessibles que via la connexion rapide.
FLAMOB_DEMO_PASSWORD=

# Emplacement du fichier de données local (prototype). Défaut : .data/flamob.json
# FLAMOB_DATA_FILE=.data/flamob.json
